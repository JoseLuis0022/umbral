# Umbral: configuración de producción. Copia este archivo a `.env` y llénalo.
# `.env` nunca se sube al repositorio.

# ── Obligatorio ──────────────────────────────────────────────────────────────

# API key de Anthropic (console.anthropic.com → API Keys).
ANTHROPIC_API_KEY=

# Firma de las sesiones. Mínimo 32 caracteres; genérala con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Si alguien la conoce puede fabricar sesiones de admin. Si la cambias, todas
# las sesiones se cierran y hay que volver a pegar la contraseña de Gmail.
JWT_SECRETO=

# ── Opcional ─────────────────────────────────────────────────────────────────

# Puerto del servidor donde se publica Umbral (nginx).
PUERTO=8080

# En qué interfaz se publica ese puerto. 0.0.0.0 = toda la red. Si Umbral vive
# detrás de un túnel de Cloudflare (cloudflared en este mismo servidor), usa
# 127.0.0.1: así nadie llega a nginx sin pasar por Cloudflare.
ENLACE=0.0.0.0

# Usar la IP que manda Cloudflare (CF-Connecting-IP) para los límites por IP
# (registros por día, intentos de login). SOLO con ENLACE=127.0.0.1 y túnel:
# si nginx es alcanzable directo, cualquiera inventa ese encabezado.
CONFIAR_CLOUDFLARE=false

# Documentación interactiva de la API en /api/docs (apagada en producción).
DOCS_API=false

# Respaldo diario de la base (servicio `respaldo`): hora en UTC y cuántos se guardan.
# HORA_RESPALDO=10
# CONSERVAR_RESPALDOS=14

# Carpeta del agente en el servidor (CLAUDE.md, material, skills).
AGENTE_DIR=./agente

# Cómo se llaman las carpetas del material dentro de la carpeta del agente.
# CARPETA_CLASES=Clases
# CARPETA_TRANSCRIPCIONES=Clases/Transcripciones
# Carpetas que el modo Consulta nunca puede leer (separadas por coma).
# CARPETAS_PRIVADAS=Prácticas
# El prompt propio de tu curso va en <carpeta del agente>/.umbral/prompts/consulta.md
# (gana sobre el genérico de backend/app/prompts/ y no se publica).

# Consultas del agente a la vez en toda la máquina; las demás esperan turno.
AGENTES_SIMULTANEOS=3

# Horas que dura una sesión antes de pedir volver a entrar.
JWT_HORAS=12

# "prueba" responde sin llamar a Claude (para probar la interfaz sin gastar).
MOTOR=sdk

# Si la app vive en una subcarpeta del dominio (p. ej. /umbral/). Recompila.
VITE_BASE_URL=/

# Dirección pública del sitio (con https, sin barra final). La usan las vistas
# previas al compartir el enlace en WhatsApp, LinkedIn, etc., el canonical, el
# JSON-LD, robots.txt, sitemap.xml y llms.txt de las páginas prerenderizadas.
# Vacía = https://umbral.imperioon.com. Recompila.
VITE_URL_PUBLICA=

# El correo de envío (Gmail + contraseña de aplicación) se configura DESDE LA
# APP: Ajustes → Registro público. No va aquí.
