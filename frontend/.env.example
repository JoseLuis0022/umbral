# Copia a .env.local si necesitas cambiar algo. Ningún valor aquí es secreto:
# todo lo que empieza con VITE_ termina dentro del bundle que descarga el navegador.

# URL base de la API. Por defecto /api (mismo origen): en desarrollo, Vite la
# reenvía al backend; en el VPS, el reverse proxy.
# VITE_API_URL=/api

# A dónde reenvía Vite /api en desarrollo.
# VITE_API_PROXY=http://localhost:8000

# 1 = el chat NO llama al backend: un simulador local emite los mismos eventos
# del protocolo. Sirve para trabajar pantallas sin backend ni tokens.
# OJO: el login sí necesita al backend.
# VITE_CHAT_SIMULADO=1

# Prefijo público donde se publica la aplicación.
#
# Vacío o ausente = raíz del dominio (https://ejemplo.mx/).
# Para publicarla dentro de una subcarpeta, escribe la carpeta con barra al
# principio y al final:
#
#   VITE_BASE_URL=/umbral/     →  https://tu-dominio.com/umbral/
#
# De aquí salen las DOS mitades del problema, que siempre van juntas: el prefijo
# de los archivos (vite.config.ts) y el prefijo de las rutas del enrutador
# (basename en App.tsx, leído con import.meta.env.BASE_URL). Se declara una sola
# vez para que no puedan desincronizarse.
#
# Se usa al COMPILAR, no al servir: cambiarlo obliga a volver a compilar.
VITE_BASE_URL=
