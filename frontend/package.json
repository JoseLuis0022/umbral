{
  "name": "umbral",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run prerender",
    "build:umbral": "tsc -b && VITE_BASE_URL=/umbral/ vite build && VITE_BASE_URL=/umbral/ npm run prerender",
    "prerender": "vite build --ssr src/prerender/entrada.tsx --outDir node_modules/.prerender && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty"
  },
  "dependencies": {
    "@fontsource-variable/google-sans": "^5.3.2",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "framer-motion": "^14.12.0",
    "lucide-react": "^1.71.0",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "react-router-dom": "^7.18.5",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remend": "^1.4.0",
    "tailwind-merge": "^3.7.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.7"
  }
}
