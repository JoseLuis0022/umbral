# Copia este archivo a .env y llénalo. .env NO va al repo.

# Llave de la API de Anthropic (los créditos del laboratorio).
# Pon un tope de gasto en la consola de Anthropic ANTES de usarla.
ANTHROPIC_API_KEY=

# Firma de los JWT. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=

# sdk = agente real (gasta tokens) · prueba = respuestas fijas, sin gastar
MOTOR=prueba

# Opcionales (estos son los valores por defecto)
# JWT_HORAS=12
# AGENTES_SIMULTANEOS=3
# AGENTE_CWD=../agente-imagenes
